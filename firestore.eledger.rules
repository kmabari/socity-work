rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if request has an active authenticated session
    function isAuthenticated() {
      return request.auth != null;
    }

    // Safely retrieve token email (lowercased) without throwing errors
    function getAuthEmail() {
      return isAuthenticated() ? request.auth.token.get('email', '') : '';
    }
    
    // Central Admin check by token email pattern, exact addresses, or Firestore admin role
    function isCentralAdmin() {
      return isAuthenticated() && (
        (getAuthEmail() != '' && (
          getAuthEmail().lower() in [
            'kmabarikiyafoods@gmail.com',
            'mabarikiyafoods@gmail.com',
            'hcrskerala@gmail.com',
            'hcrsindia@gmail.com',
            'admin@hcrs.society',
            '9645934571@hcrs.society',
            'highrichcommunityrevivalsociet@gmail.com'
          ] ||
          getAuthEmail().lower().matches('.*(hcrskerala|kmabarikiyafoods|mabarikiyafoods|hcrsindia|admin|eledger|highrich|9645934571|@hcrs).*')
        )) ||
        (exists(/databases/$(database)/documents/eledger_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/eledger_users/$(request.auth.uid)).data.get('role', '') == 'admin') ||
        (exists(/databases/$(database)/documents/eledger_users/admin-hcrskerala) &&
         getAuthEmail() != '' &&
         get(/databases/$(database)/documents/eledger_users/admin-hcrskerala).data.get('email', '').lower() == getAuthEmail().lower())
      );
    }
    
    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/eledger_users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/eledger_users/$(request.auth.uid)).data.get('role', '')
        : '';
    }
    
    function isAdmin() {
      return isCentralAdmin() || getUserRole() == 'admin';
    }
    
    function isTreasurer() {
      return isCentralAdmin() || 
             getUserRole() == 'treasurer' ||
             request.auth.uid == 'NX2b63Hzu4RFhR4BCQP5OMpI4jw1' ||
             (getAuthEmail() != '' && getAuthEmail().lower().matches('.*(treasurer|hcrstreasurer).*'));
    }
    
    function isAuditor() {
      return isCentralAdmin() || 
             getUserRole() == 'auditor' ||
             (getAuthEmail() != '' && getAuthEmail().lower().matches('.*(auditor|hcrsauditor).*'));
    }
    
    function isMember() {
      return isCentralAdmin() || getUserRole() == 'member';
    }
    
    function isCommitteeUser() {
      return isAuthenticated();
    }

    // 1. eledger_users Collection (20 Committee Members quota: 1 Admin, 1 Treasurer, 1 Auditor, 17 Members)
    match /eledger_users/{userId} {
      // Authenticated committee users can read committee users directory / check their own role
      allow read: if isAuthenticated();
      
      // Central Admin can create/update committee member profiles; Users can update own profile
      allow create, update: if isAuthenticated() && (
        isCentralAdmin() || 
        request.auth.uid == userId ||
        userId == 'admin-hcrskerala' ||
        (getAuthEmail() != '' && resource != null && resource.data.get('email', '').lower() == getAuthEmail().lower()) ||
        (getAuthEmail() != '' && request.resource != null && request.resource.data.get('email', '').lower() == getAuthEmail().lower())
      );
      
      // Only Central Admin can remove committee accounts
      allow delete: if isCentralAdmin();
    }

    // 2. Treasury Metrics (Aggregated balance and totals)
    match /eledger_treasury_metrics/{metricId} {
      // Authenticated committee users can read
      allow read: if isCommitteeUser();
      
      // Admin and Treasurer can write / recalculate metrics
      allow write: if isCentralAdmin() || isTreasurer();
    }

    // 3. Fund Categories (Statutory allocations and spent)
    match /eledger_fund_categories/{categoryId} {
      // Authenticated committee users can read
      allow read: if isCommitteeUser();
      
      // Admin and Treasurer can manage categories
      allow write: if isCentralAdmin() || isTreasurer();
    }

    // 4. Vouchers (Disbursement and income vouchers)
    match /eledger_vouchers/{voucherId} {
      // Authenticated committee users can read
      allow read: if isCommitteeUser();
      
      // Treasurer & Admin can create vouchers
      allow create: if isCentralAdmin() || isTreasurer();
      
      // Admin can approve/reject, Auditor can audit & sign, Treasurer can update draft
      allow update: if isCentralAdmin() || isTreasurer() || isAuditor();
      
      // Only Admin can delete in exceptional cases
      allow delete: if isCentralAdmin();
    }

    // 5. Member Financial Accounts (Individual credit allocations & bill claims)
    match /eledger_member_accounts/{accountId} {
      // Admin & Treasurer can read all; Member can read ONLY their own account
      allow read: if isCentralAdmin() || isTreasurer() || (
        isAuthenticated() && (
          request.auth.uid == accountId ||
          (getAuthEmail() != '' && resource != null && resource.data.get('email', '').lower() == getAuthEmail().lower())
        )
      );
      
      // Admin & Treasurer can allocate credit; Member can submit expense claims on their own account
      allow create, update: if isCentralAdmin() || isTreasurer() || (
        isAuthenticated() && (
          request.auth.uid == accountId ||
          (getAuthEmail() != '' && resource != null && resource.data.get('email', '').lower() == getAuthEmail().lower())
        )
      );
      
      allow delete: if isCentralAdmin();
    }

    // 6. Audit Logs (Immutable CA verification trails)
    match /eledger_audit_logs/{logId} {
      // Authenticated committee users can read
      allow read: if isCommitteeUser();
      
      // Auditor and Admin can append verification logs
      allow create: if isCentralAdmin() || isAuditor();
      
      // Immutable: Logs CANNOT be modified or deleted
      allow update, delete: if false;
    }

    // 7. Bank Credits (Treasurer Bank Statement entries & reconciliations)
    match /eledger_bank_credits/{creditId} {
      // Authenticated committee users can read
      allow read: if isCommitteeUser();
      
      // Treasurer & Admin can add, update, delete bank credit entries
      allow create, update, delete: if isCentralAdmin() || isTreasurer();
    }

    // Deny all other unauthenticated access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
