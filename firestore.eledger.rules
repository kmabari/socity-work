rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if request has an active authenticated session
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if token contains valid email
    function hasAuthEmail() {
      return isAuthenticated() && request.auth.token.email != null;
    }
    
    // Central Admin check by token email pattern or specific addresses
    function isInitialAdmin() {
      return isAuthenticated() && (
        (hasAuthEmail() && (
          request.auth.token.email == 'hcrskerala@gmail.com' ||
          request.auth.token.email == 'kmabarikiyafoods@gmail.com' ||
          request.auth.token.email == 'mabarikiyafoods@gmail.com' ||
          request.auth.token.email == 'hcrsindia@gmail.com' ||
          request.auth.token.email == 'admin@hcrs.society' ||
          request.auth.token.email == 'highrichcommunityrevivalsociet@gmail.com' ||
          request.auth.token.email == '9645934571@hcrs.society' ||
          request.auth.token.email.matches('(?i).*(hcrskerala|mabarikiyafoods|hcrsindia|admin|eledger|highrich|9645934571|@hcrs).*')
        )) ||
        (hasUserDoc() && 'role' in get(/databases/$(database)/documents/eledger_users/$(request.auth.uid)).data && get(/databases/$(database)/documents/eledger_users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/eledger_users/admin-hcrskerala) &&
         hasAuthEmail() &&
         'email' in get(/databases/$(database)/documents/eledger_users/admin-hcrskerala).data &&
         get(/databases/$(database)/documents/eledger_users/admin-hcrskerala).data.email == request.auth.token.email)
      );
    }
    
    // Safe lookup helper for user document existence
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/eledger_users/$(request.auth.uid));
    }
    
    // Safe lookup helper for role
    function getUserRole() {
      return hasUserDoc() && 'role' in get(/databases/$(database)/documents/eledger_users/$(request.auth.uid)).data
        ? get(/databases/$(database)/documents/eledger_users/$(request.auth.uid)).data.role 
        : '';
    }
    
    function isAdmin() {
      return isInitialAdmin() || getUserRole() == 'admin';
    }
    
    function isTreasurer() {
      return isAdmin() || getUserRole() == 'treasurer';
    }
    
    function isAuditor() {
      return isAdmin() || getUserRole() == 'auditor';
    }
    
    function isMember() {
      return isAdmin() || getUserRole() == 'member';
    }
    
    function isCommitteeUser() {
      return isAuthenticated() && (isInitialAdmin() || hasUserDoc() || isAdmin());
    }

    // 1. eledger_users Collection (20 Committee Members quota: 1 Admin, 1 Treasurer, 1 Auditor, 17 Members)
    match /eledger_users/{userId} {
      // Authenticated committee users can read committee users directory / check their own role
      allow read: if isAuthenticated();
      
      // Central Admin can create/update committee member profiles; Users can update own profile
      allow create, update: if isAuthenticated() && (
        isInitialAdmin() || 
        isAdmin() || 
        request.auth.uid == userId ||
        userId == 'admin-hcrskerala' ||
        (hasAuthEmail() && resource != null && 'email' in resource.data && resource.data.email == request.auth.token.email) ||
        (hasAuthEmail() && request.resource != null && 'email' in request.resource.data && request.resource.data.email == request.auth.token.email)
      );
      
      // Only Central Admin can remove committee accounts
      allow delete: if isInitialAdmin() || isAdmin();
    }

    // 2. Treasury Metrics (Aggregated balance and totals)
    match /eledger_treasury_metrics/{metricId} {
      // Authenticated committee users can read
      allow read: if isCommitteeUser();
      
      // Admin and Treasurer can write / recalculate metrics
      allow write: if isInitialAdmin() || isAdmin() || isTreasurer();
    }

    // 3. Fund Categories (Statutory allocations and spent)
    match /eledger_fund_categories/{categoryId} {
      // Authenticated committee users can read
      allow read: if isCommitteeUser();
      
      // Admin and Treasurer can manage categories
      allow write: if isInitialAdmin() || isAdmin() || isTreasurer();
    }

    // 4. Vouchers (Disbursement and income vouchers)
    match /eledger_vouchers/{voucherId} {
      // Authenticated committee users can read
      allow read: if isCommitteeUser();
      
      // Treasurer can create vouchers
      allow create: if isInitialAdmin() || isTreasurer() || isAdmin();
      
      // Admin can approve/reject, Auditor can audit & sign
      allow update: if isInitialAdmin() || isAdmin() || isAuditor() || isTreasurer();
      
      // Only Admin can delete in exceptional cases
      allow delete: if isInitialAdmin() || isAdmin();
    }

    // 5. Member Financial Accounts (Individual credit allocations & bill claims)
    match /eledger_member_accounts/{accountId} {
      // Admin & Treasurer can read all; Member can read ONLY their own account
      allow read: if isInitialAdmin() || isTreasurer() || (
        isAuthenticated() && (
          request.auth.uid == accountId ||
          (hasAuthEmail() && resource != null && 'email' in resource.data && resource.data.email == request.auth.token.email)
        )
      );
      
      // Admin & Treasurer can allocate credit; Member can submit expense claims on their own account
      allow create, update: if isInitialAdmin() || isTreasurer() || (
        isAuthenticated() && (
          request.auth.uid == accountId ||
          (hasAuthEmail() && resource != null && 'email' in resource.data && resource.data.email == request.auth.token.email)
        )
      );
      
      allow delete: if isInitialAdmin() || isAdmin();
    }

    // 6. Audit Logs (Immutable CA verification trails)
    match /eledger_audit_logs/{logId} {
      // Authenticated committee users can read
      allow read: if isCommitteeUser();
      
      // Auditor and Admin can append verification logs
      allow create: if isInitialAdmin() || isAuditor() || isAdmin();
      
      // Immutable: Logs CANNOT be modified or deleted
      allow update, delete: if false;
    }

    // Deny all other unauthenticated or non-eledger access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

