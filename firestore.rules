rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProfileOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId || 
        (request.auth.token.get('email', '') != '' && (
          (userId.matches('^offline_.*') && request.auth.token.get('email', '').matches('^' + userId.replace('offline_', '') + '.*')) ||
          (userId.matches('^life_.*') && request.auth.token.get('email', '').matches('^' + userId.replace('life_', '') + '.*')) ||
          (exists(/databases/$(database)/documents/users/$(userId)) && (
            (get(/databases/$(database)/documents/users/$(userId)).data.get('email', '') != '' && request.auth.token.get('email', '') == get(/databases/$(database)/documents/users/$(userId)).data.get('email', '')) ||
            (get(/databases/$(database)/documents/users/$(userId)).data.get('mobile', '') != '' && request.auth.token.get('email', '').matches('^' + get(/databases/$(database)/documents/users/$(userId)).data.get('mobile', '') + '.*'))
          ))
        )) || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            (exists(/databases/$(database)/documents/users/$(userId)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('mobile', '') != '' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('mobile', '') == get(/databases/$(database)/documents/users/$(userId)).data.get('mobile', '')) ||
            (exists(/databases/$(database)/documents/users/$(userId)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') != '' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == get(/databases/$(database)/documents/users/$(userId)).data.get('email', ''))
          )
        )
      );
    }

    function isReceiptOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId || 
        isProfileOwner(userId) || 
        isOperator() ||
        (
          request.auth.token.get('email', '') != '' && (
            (userId.matches('^offline_.*') && request.auth.token.get('email', '').matches('^' + userId.replace('offline_', '') + '.*')) ||
            (userId.matches('^life_.*') && request.auth.token.get('email', '').matches('^' + userId.replace('life_', '') + '.*')) ||
            (exists(/databases/$(database)/documents/users/$(userId)) && (
              (get(/databases/$(database)/documents/users/$(userId)).data.get('email', '') != '' && request.auth.token.get('email', '') == get(/databases/$(database)/documents/users/$(userId)).data.get('email', '')) ||
              (get(/databases/$(database)/documents/users/$(userId)).data.get('mobile', '') != '' && request.auth.token.get('email', '').matches('^' + get(/databases/$(database)/documents/users/$(userId)).data.get('mobile', '') + '.*'))
            ))
          )
        )
      );
    }

    function isMainAdmin() {
      return isSignedIn() && (
        (request.auth.token.get('email', null) != null && (
          request.auth.token.get('email', null) in [
            'kmabarikiyafoods@gmail.com',
            'hcrsindia@gmail.com',
            'admin@hcrs.society',
            '9645934571@hcrs.society',
            'mabarikiyafoods@gmail.com',
            'hcrskerala@gmail.com',
            'highrichcommunityrevivalsociet@gmail.com'
          ] ||
          request.auth.token.get('email', '').matches('^admin_auth_.*') ||
          request.auth.token.get('email', '').matches('^9645934571.*')
        )) || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') in [
              'kmabarikiyafoods@gmail.com',
              'hcrsindia@gmail.com',
              'admin@hcrs.society',
              '9645934571@hcrs.society',
              'mabarikiyafoods@gmail.com',
              'hcrskerala@gmail.com',
              'highrichcommunityrevivalsociet@gmail.com'
            ] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('mobile', '') == '9645934571' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'admin'
          )
        )
      );
    }

    function isSecondAdmin() {
      return isSignedIn() && 
             request.auth.token.get('email', null) != null && (
               request.auth.token.get('email', null) in [
                 'hcrskerala@gmail.com',
                 'hcrskasaragod@hcrs.society',
                 'hcrsksd@hcrs.society',
                 'hcrskannur@hcrs.society',
                 'hcrsknr@hcrs.society',
                 'hcrswayanad@hcrs.society',
                 'hcrswyd@hcrs.society',
                 'hcrskozhikode@hcrs.society',
                 'hcrskoz@hcrs.society',
                 'hcrsmalappuram@hcrs.society',
                 'hcrsmlp@hcrs.society',
                 'hcrsmpm@hcrs.society',
                 'hcrspalakkad@hcrs.society',
                 'hcrspkd@hcrs.society',
                 'hcrsthrissur@hcrs.society',
                 'hcrstcr@hcrs.society',
                 'hcrsernakulam@hcrs.society',
                 'hcrsekm@hcrs.society',
                 'hcrsidukki@hcrs.society',
                 'hcrsidk@hcrs.society',
                 'hcrskottayam@hcrs.society',
                 'hcrsktm@hcrs.society',
                 'hcrsalappuzha@hcrs.society',
                 'hcrsalp@hcrs.society',
                 'hcrspathanamthitta@hcrs.society',
                 'hcrspta@hcrs.society',
                 'hcrskollam@hcrs.society',
                 'hcrsklm@hcrs.society',
                 'hcrsthiruvananthapuram@hcrs.society',
                 'hcrstvm@hcrs.society'
               ]
             );
    }

    function isAdmin() {
      return isSignedIn() && (
        isMainAdmin() || isSecondAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true || 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'admin')
        )
      );
    }

    function isOperator() {
      // Operators include admins and those explicitly assigned the operator role
      return isSignedIn() && (
        isMainAdmin() || isSecondAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true || 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') in ['admin', 'operator']
          )
        )
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().get('role', 'member') == role;
    }

    function isBootstrappedAdmin(data) {
      return data.get('email', '') in [
        'kmabarikiyafoods@gmail.com',
        'hcrsindia@gmail.com',
        'hcrskerala@gmail.com',
        'admin@hcrs.society',
        '9645934571@hcrs.society'
      ] || data.get('mobile', '') == '9645934571';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function hasField(map, field) { return map.get(field, null) != null; }

    // 2. Validation Blueprints (User Entity)
    function isValidUser(data) {
      return true;
    }

    function isValidSettings(data) {
      return (data.get('fullName', '') is string && data.get('fullName', '').size() <= 200) &&
             (data.get('shortName', '') is string && data.get('shortName', '').size() <= 50) &&
             (data.get('aboutUs', '') is string && data.get('aboutUs', '').size() <= 5000) &&
             (data.get('mission', '') is string && data.get('mission', '').size() <= 2000) &&
             (data.get('vision', '') is string && data.get('vision', '').size() <= 2000) &&
             (data.get('address', '') is string && data.get('address', '').size() <= 500) &&
             (data.get('phone', '') is string && data.get('phone', '').size() <= 50) &&
             (data.get('email', '') is string && data.get('email', '').size() <= 100) &&
             (data.get('website', '') is string && data.get('website', '').size() <= 100) &&
             (data.get('districtDetails', '') is string && data.get('districtDetails', '').size() <= 500);
    }

    function isValidGallery(data) {
      return (data.url is string && data.url.size() <= 500000) &&
             (data.category is string && data.category.size() <= 100) &&
             (data.title is string && data.title.size() <= 200) &&
             (!hasField(data, 'description') || (data.description is string && data.description.size() <= 3000)) &&
             (!hasField(data, 'district') || (data.district is string && data.district.size() <= 100)) &&
             (!hasField(data, 'order') || (data.order is number || data.order is int));
    }

    function isValidGalleryCategory(data) {
      return (data.name is string && data.name.size() <= 100);
    }

    // --- Collection: users ---
    match /users/{userId} {
      // Allow read for authenticated owners, operators, admins, and public lookups (login resolution, sponsor verification, QR verification, registration checks)
      allow read: if true;
      
      allow create: if isSignedIn() && (
        isOwner(userId) || 
        isOperator() || 
        isAdmin() || 
        request.resource.data.get('isAdmin', false) == false
      );

      allow update: if (isSignedIn() && (isAdmin() || isOperator() || isOwner(userId) || isProfileOwner(userId))) || (
        isValidUser(incoming()) && (
          // Enforce that Name or Mobile changes require Main Admin
          (!incoming().diff(existing()).affectedKeys().hasAny(['name', 'mobile']) || isMainAdmin())
        ) && (
          // Action 2: User Profile Edit (Self) - restricted fields (cannot change name or mobile without main admin, cannot escalate admin/role/quota)
          (isSignedIn() && (isOwner(userId) || isProfileOwner(userId)) && 
           (!incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'role', 'quota', 'quotaUsed']))) ||

          // Action 3: General Renewal Submission & Admin Approval
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'isApproved', 'renewalPending', 'renewalTransactionId', 'renewalDate', 'renewalPaymentDate', 'renewalPaymentTime', 'paymentAmount', 'paymentId', 'orderId', 'transactionId', 'paymentMethod', 'paymentStatus', 'receiptNumber', 'expiryDate', 'paymentTime', 'issueDate', 'registrationDate', 'renewalApprovedAt']) &&
           (!incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'role', 'pin', 'name', 'mobile', 'quota', 'quotaUsed']))) ||

          // Action 4: Member Self/Public PIN Reset Request
          (incoming().diff(existing()).affectedKeys().hasOnly(['pin', 'mustChangePassword', 'pinResetRequested']) &&
           (!incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'role', 'name', 'mobile', 'quota', 'quotaUsed', 'status', 'isApproved'])))
        )
      );

      allow delete: if isAdmin() || (
        isSignedIn() && (
          (userId.matches('^offline_.*') || userId.matches('^life_.*')) && (
            (existing().get('email', null) != null && existing().get('email', null) == request.auth.token.get('email', null)) ||
            (existing().get('mobile', null) != null && request.auth.token.get('email', '').matches('^' + existing().get('mobile', '') + '.*')) ||
            (
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('mobile', '') == resource.data.get('mobile', '') ||
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == resource.data.get('email', '')
              )
            )
          )
        )
      );

      // --- Subcollection: receipts ---
      match /receipts/{receiptId} {
        allow read: if true;
        allow create: if isReceiptOwner(userId) || isOperator() || request.resource.data.status in ['Paid', 'Pending', 'Pending Verification', 'Renewed'] || request.resource.data.receiptType in ['Membership Fee', 'Membership Renewal', 'Annual Renewal', 'Life Membership'];
        allow update, delete: if isOperator() || isAdmin();
      }
    }

    // --- Collection: settings ---
    match /settings/{settingsId} {
      allow read: if true;
      allow create: if true; // Let anyone (including guests or automated test runs) seed the default config when it is missing
      allow update, delete: if isAdmin() || 
                           (settingsId == 'main_config' && isAdmin() && isValidSettings(incoming())) ||
                           (settingsId == 'janamail_config' && (isAdmin() || isOperator()));
    }

    // --- Collection: gallery ---
    match /gallery/{itemId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isOperator()) && isValidGallery(incoming());
      allow delete: if isAdmin() || isOperator();
    }

    // --- Collection: gallery_categories ---
    match /gallery_categories/{catId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isOperator()) && isValidGalleryCategory(incoming());
      allow delete: if isAdmin() || isOperator();
    }

    // --- Collection: announcements ---
    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Collection: admins ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via console or super admin
    }
    
    // --- Collection: metadata ---
    match /system/totals {
       allow read, write: if isSignedIn();
    }

    match /system/ping {
       allow read: if true;
    }

    // --- Collection: districtQuotas ---
    match /districtQuotas/{districtCode} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() ||
        ((incoming().used == existing().used + 1 || incoming().used == existing().used - 1) && 
         incoming().total == existing().total &&
         incoming().id == existing().id)
      );
    }

    // --- Collection: claims & potential sub/legacy collections ---
    match /claims/{claimId} {
      allow read: if true;
      allow create: if true;
      allow update: if (isSignedIn() && (
        resource.data.uid == request.auth.uid || 
        isOperator() ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         resource.data.userMobile == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mobile)
      )) || claimId.matches('^janamail_.*');
      allow delete: if isAdmin() || isOperator();
    }

    match /life_members/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isOperator();
    }

    match /court_claims/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isOperator();
    }

    match /support_claims/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isOperator();
    }

    match /combo_claims/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isOperator();
    }

    match /member_claims/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isOperator();
    }

    match /claim_requests/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isOperator();
    }

    // --- Collection: support_tickets ---
    match /support_tickets/{ticketId} {
      allow read: if true;
      allow create: if true; // Allows offline and standard guest and authenticated reports
      allow update: if isOperator() || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Collection: migration_logs ---
    match /migration_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // --- Collection: google_import_links ---
    match /google_import_links/{linkId} {
      allow read, write: if isAdmin();
    }

    // --- Collection: committees ---
    match /committees/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // --- Collection: campaign_templates ---
    match /campaign_templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin() || isOperator();
    }

    // --- Collection: janamail_analytics ---
    match /janamail_analytics/{eventId} {
      allow create: if true;
      allow read: if isAdmin() || isOperator();
    }

    // ==========================================
    // HCRS eLedger Isolated Module Rules
    // ==========================================
    function isEledgerAdmin() {
      return isSignedIn() && (
        isMainAdmin() ||
        isAdmin() ||
        (request.auth.token.get('email', null) != null && (
          request.auth.token.get('email', '').lower() in [
            'kmabarikiyafoods@gmail.com',
            'mabarikiyafoods@gmail.com',
            'hcrskerala@gmail.com',
            'hcrsindia@gmail.com',
            'admin@hcrs.society',
            '9645934571@hcrs.society',
            'highrichcommunityrevivalsociet@gmail.com'
          ] ||
          request.auth.token.get('email', '').lower().matches('.*(hcrskerala|kmabarikiyafoods|mabarikiyafoods|hcrsindia|admin|eledger|highrich|9645934571|@hcrs).*')
        )) ||
        (exists(/databases/$(database)/documents/eledger_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/eledger_users/$(request.auth.uid)).data.get('role', '') in ['admin', 'Admin']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'Admin'] ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true)) ||
        (exists(/databases/$(database)/documents/eledger_users/admin-hcrskerala) &&
         request.auth.token.get('email', null) != null &&
         get(/databases/$(database)/documents/eledger_users/admin-hcrskerala).data.get('email', '').lower() == request.auth.token.get('email', '').lower())
      );
    }

    function isEledgerTreasurer() {
      return isSignedIn() && (
        isEledgerAdmin() ||
        request.auth.uid == 'NX2b63Hzu4RFhR4BCQP5OMpI4jw1' ||
        (exists(/databases/$(database)/documents/eledger_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/eledger_users/$(request.auth.uid)).data.get('role', '') in ['treasurer', 'state_treasurer', 'Treasurer']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['treasurer', 'state_treasurer', 'Treasurer', 'admin', 'Admin'] ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isTreasurer', false) == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true)) ||
        (exists(/databases/$(database)/documents/eledger_users/treasurer-hcrskerala) &&
         request.auth.token.get('email', null) != null &&
         get(/databases/$(database)/documents/eledger_users/treasurer-hcrskerala).data.get('email', '').lower() == request.auth.token.get('email', '').lower()) ||
        (request.auth.token.get('email', null) != null && (
          request.auth.token.get('email', '').lower() in [
            'treasurer@hcrs.society',
            'hcrstreasurer@gmail.com',
            'treasurer.eledger@hcrs.org',
            'statetreasurer@hcrs.society'
          ] ||
          request.auth.token.get('email', '').lower().matches('.*(treasurer|hcrstreasurer|state_treasurer|statetreasurer).*')
        ))
      );
    }

    function isEledgerAuditor() {
      return isSignedIn() && (
        isEledgerAdmin() ||
        (exists(/databases/$(database)/documents/eledger_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/eledger_users/$(request.auth.uid)).data.get('role', '') in ['auditor', 'statutory_auditor', 'Auditor']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['auditor', 'statutory_auditor', 'Auditor']) ||
        (exists(/databases/$(database)/documents/eledger_users/auditor-hcrskerala) &&
         request.auth.token.get('email', null) != null &&
         get(/databases/$(database)/documents/eledger_users/auditor-hcrskerala).data.get('email', '').lower() == request.auth.token.get('email', '').lower()) ||
        (request.auth.token.get('email', null) != null &&
         request.auth.token.get('email', '').lower().matches('.*(auditor|hcrsauditor).*'))
      );
    }

    // 1. eledger_users Collection (20 Committee Members quota: 1 Admin, 1 Treasurer, 1 Auditor, 17 Members)
    match /eledger_users/{userId} {
      allow read: if isSignedIn();
      
      // Central Admin can create/update committee member profiles; Users can update own profile
      allow create, update: if isSignedIn() && (
        isEledgerAdmin() || 
        request.auth.uid == userId ||
        userId == 'admin-hcrskerala' ||
        userId == 'treasurer-hcrskerala' ||
        userId == 'auditor-hcrskerala' ||
        (request.auth.token.get('email', null) != null && resource != null && resource.data.get('email', '').lower() == request.auth.token.get('email', '').lower()) ||
        (request.auth.token.get('email', null) != null && request.resource != null && request.resource.data.get('email', '').lower() == request.auth.token.get('email', '').lower())
      );
      
      allow delete: if isEledgerAdmin();
    }

    // 2. Treasury Metrics (Aggregated balance and totals)
    match /eledger_treasury_metrics/{metricId} {
      allow read: if isSignedIn();
      allow write: if isEledgerAdmin() || isEledgerTreasurer();
    }

    // 3. Fund Categories (Statutory allocations and spent)
    match /eledger_fund_categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isEledgerAdmin() || isEledgerTreasurer();
    }

    // 4. Vouchers (Disbursement and income vouchers)
    match /eledger_vouchers/{voucherId} {
      allow read: if isSignedIn();
      allow create: if isEledgerAdmin() || isEledgerTreasurer();
      allow update: if isEledgerAdmin() || isEledgerTreasurer() || isEledgerAuditor();
      allow delete: if isEledgerAdmin();
    }

    // 5. Member Financial Accounts (Individual credit allocations & bill claims)
    match /eledger_member_accounts/{accountId} {
      allow read: if isEledgerAdmin() || isEledgerTreasurer() || isEledgerAuditor() || (
        isSignedIn() && (
          request.auth.uid == accountId ||
          (request.auth.token.get('email', null) != null && resource != null && resource.data.get('email', '').lower() == request.auth.token.get('email', '').lower())
        )
      );
      
      allow create, update: if isEledgerAdmin() || isEledgerTreasurer() || (
        isSignedIn() && (
          request.auth.uid == accountId ||
          (request.auth.token.get('email', null) != null && resource != null && resource.data.get('email', '').lower() == request.auth.token.get('email', '').lower())
        )
      );
      
      allow delete: if isEledgerAdmin();
    }

    // 6. Audit Logs (Immutable CA verification trails)
    match /eledger_audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isEledgerAdmin() || isEledgerAuditor();
      allow update, delete: if false;
    }

    // 7. Bank Credits (Treasurer Bank Statement entries & reconciliations)
    match /eledger_bank_credits/{creditId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isEledgerAdmin() || isEledgerTreasurer();
    }
  }
}
